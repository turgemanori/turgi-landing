{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/for/:token", "destination": "/for.html" }
  ],
  "redirects": [
    { "source": "/book", "destination": "/hello", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(css|js|images)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }]
    },
    {
      "source": "/(admin|for/.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }, { "key": "Referrer-Policy", "value": "no-referrer" }]
    }
  ]
}
